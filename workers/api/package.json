{
  "name": "sonor-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build && wrangler dev",
    "build": "node scripts/copy-receiver.mjs",
    "pretest": "pnpm --filter \"sonor-api...\" build",
    "deploy": "pnpm --filter \"sonor-api...\" build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "sonor-cast-receiver": "workspace:*"
  }
}
