{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sonor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "api.sonor.fi", "custom_domain": true }],
  // Requests carry IPs: no request logs, ever.
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "API_STATE", "class_name": "ApiState" }]
  },
  // The Cast receiver skin (public/cast/) is served by the Worker, which sees every request first.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiState"] }],
  "analytics_engine_datasets": [
    { "binding": "RELEASE_CHECKS", "dataset": "sonor_release_checks" },
    { "binding": "UPSTREAM_CHECKS", "dataset": "sonor_upstream_checks" }
  ]
}
