{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonor-fi",
  "compatibility_date": "2026-11-16",
  // The placeholder is static; nothing about visitors is logged.
  "observability": { "enabled": false },
  "workers_dev": true,
  "routes": [
    { "pattern": "sonor.fi", "custom_domain": true },
    { "pattern": "www.sonor.fi", "custom_domain": true }
  ],
  "assets": { "directory": "public" }
}
