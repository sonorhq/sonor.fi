{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonor-fi",
  "compatibility_date": "2026-11-16",
  "main": "src/index.ts",
  // Nothing about visitors is logged; the Worker only redirects and adds headers.
  "observability": { "enabled": false },
  "workers_dev": true,
  "routes": [
    { "pattern": "sonor.fi", "custom_domain": true },
    { "pattern": "www.sonor.fi", "custom_domain": true }
  ],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true }
}
